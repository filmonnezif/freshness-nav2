# ROS 2 Jazzy with the two Nav2 components used by the experiment.
# The paper used nav2-collision-monitor and nav2-velocity-smoother
# 1.3.13-1noble.20260903 (recorded in evidence/*/results.json).
FROM docker.io/library/ros:jazzy-ros-base-noble

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    ros-jazzy-nav2-collision-monitor \
    ros-jazzy-nav2-velocity-smoother \
    python3-numpy \
    python3-matplotlib \
    && rm -rf /var/lib/apt/lists/*

ENV ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST
WORKDIR /workspace
CMD ["bash"]
